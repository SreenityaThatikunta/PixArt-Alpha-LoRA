# Weights & Biases - required only when training with --use_wandb
# Get your key at https://wandb.ai/authorize
WANDB_API_KEY=

# Optional: override the W&B project / entity used by train.py
WANDB_PROJECT=pixart-hands-lora
WANDB_ENTITY=

# HuggingFace token - needed to push LoRA checkpoints to the Hub,
# or to pull gated base models. Read-only is enough for inference.
# Get one at https://huggingface.co/settings/tokens
HF_TOKEN=

# Optional: cache location for downloaded base models (~6 GB for PixArt-XL)
HF_HOME=
